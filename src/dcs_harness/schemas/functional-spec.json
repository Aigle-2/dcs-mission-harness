{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "classification", "mission", "purpose", "player_experience", "flow", "success", "failure", "constraints", "assumptions", "open_questions", "criteria"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "classification": {"enum": ["private", "public-candidate", "public-approved"]},
    "mission": {"type": "object"},
    "purpose": {"type": "string", "minLength": 10},
    "player_experience": {"type": "string", "minLength": 10},
    "flow": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 5}},
    "success": {"type": "string", "minLength": 5},
    "failure": {"type": "string", "minLength": 5},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "criteria": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "level"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,31}$"}, "statement": {"type": "string", "minLength": 10}, "level": {"enum": ["local", "runtime", "client"]}}
    }}
  }
}
