{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "classification", "mission", "purpose", "player_experience", "flow", "success", "failure", "constraints", "assumptions", "open_questions", "criteria", "design_decisions", "communications", "configuration", "support_flights", "liveries"],
  "$defs": {
    "altitude": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "reference"],
      "properties": {
        "value": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"enum": ["ft", "m"]},
        "reference": {"const": "MSL"}
      }
    },
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "orbit": {
      "oneOf": [
        {"type": "object", "additionalProperties": false,
          "required": ["pattern", "center", "radius_nm"],
          "properties": {
            "pattern": {"const": "Circle"},
            "center": {"$ref": "#/$defs/point"},
            "radius_nm": {"type": "number", "exclusiveMinimum": 0}
          }},
        {"type": "object", "additionalProperties": false,
          "required": ["pattern", "start", "end"],
          "properties": {
            "pattern": {"const": "Race-Track"},
            "start": {"$ref": "#/$defs/point"},
            "end": {"$ref": "#/$defs/point"}
          }}
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.5"},
    "liveries": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "source", "evidence"],
      "properties": {
        "decision": {"enum": ["pending", "default", "custom"]},
        "source": {"enum": ["unanswered", "user-request", "user-confirmation"]},
        "evidence": {"type": "string", "minLength": 10},
        "selections": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["group", "aircraft", "livery_id"],
          "properties": {
            "group": {"type": "string", "minLength": 1},
            "unit": {"type": "string", "minLength": 1},
            "aircraft": {"type": "string", "minLength": 1},
            "livery_id": {"type": "string", "minLength": 1}
          }
        }}
      },
      "allOf": [
        {"if": {"properties": {"decision": {"const": "custom"}}}, "then": {"required": ["selections"]}},
        {"if": {"properties": {"decision": {"const": "default"}}}, "then": {"not": {"required": ["selections"]}}}
      ]
    },
    "support_flights": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group", "role", "aircraft", "cruise_altitude", "mission_altitude", "orbit", "status", "source", "evidence"],
        "properties": {
          "group": {"type": "string", "minLength": 1},
          "role": {"enum": ["awacs", "tanker"]},
          "aircraft": {"type": "string", "minLength": 1},
          "cruise_altitude": {"$ref": "#/$defs/altitude"},
          "mission_altitude": {"$ref": "#/$defs/altitude"},
          "orbit": {"$ref": "#/$defs/orbit"},
          "refueling_system": {"enum": ["boom", "probe-drogue"]},
          "receivers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["proposed", "confirmed"]},
          "source": {"enum": ["agent-proposal", "user-request", "user-confirmation"]},
          "evidence": {"type": "string", "minLength": 10}
        },
        "allOf": [
          {"if": {"properties": {"role": {"const": "tanker"}}}, "then": {"required": ["refueling_system", "receivers"]}},
          {"if": {"properties": {"role": {"const": "awacs"}}}, "then": {"not": {"anyOf": [{"required": ["refueling_system"]}, {"required": ["receivers"]}]}}}
        ]
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["carrier_present", "awacs_present", "ai_skill", "ai_skill_source"],
      "properties": {
        "carrier_present": {"type": "boolean"},
        "awacs_present": {"type": "boolean"},
        "ai_skill": {"enum": ["Average", "Good", "High", "Excellent", "Random"]},
        "ai_skill_source": {"enum": ["default-policy", "user-request", "user-confirmation"]}
      }
    },
    "design_decisions": {"type": "array", "minItems": 6, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "choice", "status", "source", "evidence"],
      "properties": {
        "topic": {"enum": ["support", "air-defence", "victory", "battlegroup", "carrier-placement", "aircraft-loadouts"]},
        "choice": {"type": "string", "minLength": 5},
        "status": {"enum": ["proposed", "confirmed", "not-applicable"]},
        "source": {"enum": ["agent-proposal", "user-request", "user-confirmation"]},
        "evidence": {"type": "string", "minLength": 10}
      }
    }},
    "communications": {"type": "object", "additionalProperties": false,
      "required": ["decision", "source", "evidence"],
      "properties": {
        "decision": {"enum": ["pending", "enabled", "declined"]},
        "source": {"enum": ["unanswered", "user-request", "user-confirmation"]},
        "evidence": {"type": "string", "minLength": 10},
        "plan": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"decision": {"const": "enabled"}}}, "then": {"required": ["plan"]}},
        {"if": {"properties": {"decision": {"const": "declined"}}}, "then": {"not": {"required": ["plan"]}}}
      ]
    },
    "classification": {"enum": ["private", "public-candidate", "public-approved"]},
    "mission": {"type": "object"},
    "purpose": {"type": "string", "minLength": 10},
    "player_experience": {"type": "string", "minLength": 10},
    "flow": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 5}},
    "success": {"type": "string", "minLength": 5},
    "failure": {"type": "string", "minLength": 5},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "criteria": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "level"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,31}$"}, "statement": {"type": "string", "minLength": 10}, "level": {"enum": ["local", "runtime", "client"]}}
    }}
  }
}
