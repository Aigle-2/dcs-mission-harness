{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "classification", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "classification": {"const": "public-approved"},
    "files": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "license", "classification"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "license": {"enum": ["MIT", "Apache-2.0", "BSD-3-Clause", "CC0-1.0"]},
        "classification": {"const": "public-approved"}
      }
    }}
  }
}
