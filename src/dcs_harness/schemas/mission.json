{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "title", "classification", "theatre", "multiplayer", "slots", "objectives", "integrations", "acceptance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "classification": {"enum": ["private", "public-candidate", "public-approved"]},
    "theatre": {"type": "string", "minLength": 1},
    "multiplayer": {"const": true},
    "slots": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["aircraft", "coalition", "count"],
      "properties": {"aircraft": {"type": "string", "minLength": 1}, "coalition": {"enum": ["blue", "red"]}, "count": {"type": "integer", "minimum": 1, "maximum": 100}}
    }},
    "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "integrations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "scope"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "version": {"type": "string", "minLength": 1}, "scope": {"enum": ["mission", "server", "client", "external"]}}
    }},
    "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
