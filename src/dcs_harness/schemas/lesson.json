{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "classification", "status", "category", "problem", "recommendation", "tags", "evidence", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "classification": {"enum": ["private", "public-candidate", "public-approved"]},
    "status": {"enum": ["candidate", "validated", "disputed", "superseded", "archived"]},
    "category": {"enum": ["bug", "constraint", "design", "preference", "ops"]},
    "problem": {"type": "string", "minLength": 1, "maxLength": 1000},
    "recommendation": {"type": "string", "minLength": 1, "maxLength": 1000},
    "tags": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "test": {"type": "string"}
  }
}
