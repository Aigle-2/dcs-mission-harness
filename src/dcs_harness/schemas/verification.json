{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "classification", "spec_sha256", "artifact_sha256", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"}, "classification": {"const": "private"},
    "spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checks": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["criterion", "status", "evidence"],
      "properties": {"criterion": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED", "INCONCLUSIVE"]}, "evidence": {"type": "string", "minLength": 5}}
    }}
  }
}
