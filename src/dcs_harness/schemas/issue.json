{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "classification", "context", "expected", "evidence", "acceptance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"enum": ["bug", "feature", "task"]},
    "title": {"type": "string", "minLength": 8, "maxLength": 160},
    "classification": {"const": "public-approved"},
    "context": {"type": "string", "minLength": 10, "maxLength": 5000},
    "expected": {"type": "string", "minLength": 10, "maxLength": 5000},
    "actual": {"type": "string", "minLength": 1, "maxLength": 5000},
    "reproduction": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5, "maxLength": 1000}},
    "scope": {"type": "string", "maxLength": 2000},
    "labels": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"}}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "bug"}}}, "then": {"required": ["actual", "reproduction"]}}]
}
